#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

if sys.argv[1:] in (["_observe-activity"], ["_observe-activity", "codex"]):
    from graphflow.activity import hook
    sys.exit(hook("codex" if len(sys.argv) == 3 else "claude"))

try:
    import graphflow.cli as cli
except ModuleNotFoundError as exc:
    if exc.name != "graphflow.cli":
        raise
    print(json.dumps({"ok": False, "code": "not_implemented",
                      "message": "graphflow.cli is not implemented yet"}))
    sys.exit(2)

sys.exit(cli.main(sys.argv[1:]))
